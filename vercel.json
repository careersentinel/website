{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.careersentinel.de" }],
      "destination": "https://careersentinel.de/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/de/index.html", "destination": "/de/", "permanent": true }
  ]
}
